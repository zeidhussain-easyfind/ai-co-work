# efps-geotag-manager — environment variables
# Copy this file to .env and fill in real values locally.
# NEVER commit .env — it is in .gitignore.

# Directory containing images to process
IMAGE_DIR=./target_images

# Default GPS latitude in decimal degrees
# Positive = North, Negative = South
# Range: -90.0 to 90.0
DEFAULT_LATITUDE=

# Default GPS longitude in decimal degrees
# Positive = East, Negative = West
# Range: -180.0 to 180.0
DEFAULT_LONGITUDE=

# Whether to create backup files before modifying images
# true  = creates file.jpg_original backups (safe, reversible)
# false = overwrites originals directly (no backup)
BACKUP=false
