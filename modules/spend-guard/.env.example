# efps-spend-guard — environment variables
# Copy this file to .env and fill in real values locally.
# NEVER commit .env — it is in .gitignore.
# In production, all values are fetched from AWS Secrets Manager
# under the path: efps/spend-guard/{secret-name}

# AWS region where resources are deployed
AWS_REGION=ap-south-1

# AWS account ID
AWS_ACCOUNT_ID=

# Alert notification email
ALERT_EMAIL=

# Daily spend threshold in USD that triggers the hard stop
SPEND_THRESHOLD_USD=5
