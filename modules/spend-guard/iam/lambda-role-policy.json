{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EC2StopAccess",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:StopInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RDSStopAccess",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances",
        "rds:DescribeDBClusters",
        "rds:StopDBInstance",
        "rds:StopDBCluster"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaThrottleAccess",
      "Effect": "Allow",
      "Action": [
        "lambda:ListFunctions",
        "lambda:PutFunctionConcurrency"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsAccess",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
